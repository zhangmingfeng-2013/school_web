# ============================================================
# 多合一工具箱 Web 版 — 速率限制配置
# 用法: 复制为 .env 或直接设置环境变量后启动
#       RATE_LOGIN_MAX=10 RATE_LOGIN_WINDOW=120 python app.py
#
# 改动环境变量后重启应用即可生效，无需改代码
# ============================================================

# ---- 全局速率限制（before_request，影响所有非静态路由） ----
# 10 秒窗口内最多 40 次请求，超标后封禁 240 秒
RATE_GLOBAL_LIMIT=40
RATE_GLOBAL_WINDOW=10
RATE_BLOCK_DURATION=240
RATE_BLOCK_PROBE=50
RATE_BLOCK_EXTEND=240

# ---- 单路由速率限制（per-route） ----

# 登录页面 (GET /) 每IP时间窗口内最大请求数
RATE_LOGINPAGE_MAX=30
RATE_LOGINPAGE_WINDOW=60

# 登录提交 (POST /) 每IP时间窗口内最大请求数
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW=60

# 注册提交 (POST /register) 每IP时间窗口内最大请求数
RATE_REGISTER_MAX=5
RATE_REGISTER_WINDOW=60

# 验证码请求 (GET /api/captcha) 每IP时间窗口内最大请求数
RATE_CAPTCHA_MAX=10
RATE_CAPTCHA_WINDOW=60
